{"id":"gre-words","version":1,"updatedAt":"2026-11-12","name":"Exam vocab: useful words","category":"Exams","blurb":"steady","colors":["#C3B1FF","#FF8E72"],"cards":[{"uid":"gre-words/0001","front":"ephemeral","back":"Lasting a very short time"},{"uid":"gre-words/0002","front":"laconic","back":"Using very few words"},{"uid":"gre-words/0003","front":"ubiquitous","back":"Found everywhere"},{"uid":"gre-words/0004","front":"ameliorate","back":"To make something bad a little better"},{"uid":"gre-words/0005","front":"equivocate","back":"To speak vaguely so as to avoid committing to an answer"},{"uid":"gre-words/0006","front":"obdurate","back":"Stubbornly refusing to change one's mind"},{"uid":"gre-words/0007","front":"perfunctory","back":"Done quickly, with little interest or care"},{"uid":"gre-words/0008","front":"pragmatic","back":"Dealing with things sensibly and realistically"},{"uid":"gre-words/0009","front":"sycophant","back":"A person who flatters the powerful to get ahead"},{"uid":"gre-words/0010","front":"venerate","back":"To regard with deep respect"},{"uid":"gre-words/0011","front":"anomaly","back":"Something that differs from what is normal or expected"},{"uid":"gre-words/0012","front":"benevolent","back":"Kind and wishing to do good"},{"uid":"gre-words/0013","front":"candid","back":"Honest and direct, even when it is uncomfortable"},{"uid":"gre-words/0014","front":"cogent","back":"Clear, logical and convincing"},{"uid":"gre-words/0015","front":"diffident","back":"Shy and lacking confidence"},{"uid":"gre-words/0016","front":"eloquent","back":"Fluent and persuasive in speech or writing"},{"uid":"gre-words/0017","front":"fastidious","back":"Very careful about detail, or hard to please"},{"uid":"gre-words/0018","front":"gregarious","back":"Fond of company; sociable"},{"uid":"gre-words/0019","front":"hackneyed","back":"Overused and lacking freshness"},{"uid":"gre-words/0020","front":"iconoclast","back":"Someone who attacks cherished beliefs or traditions"},{"uid":"gre-words/0021","front":"juxtapose","back":"To place side by side for contrast"},{"uid":"gre-words/0022","front":"loquacious","back":"Talking a great deal"},{"uid":"gre-words/0023","front":"meticulous","back":"Showing great attention to detail"},{"uid":"gre-words/0024","front":"nebulous","back":"Vague and unclear"},{"uid":"gre-words/0025","front":"ostentatious","back":"Showy, meant to impress"},{"uid":"gre-words/0026","front":"panacea","back":"A supposed cure for all problems"},{"uid":"gre-words/0027","front":"quixotic","back":"Idealistic in a way that is impractical"},{"uid":"gre-words/0028","front":"recalcitrant","back":"Resisting authority or control"},{"uid":"gre-words/0029","front":"sagacious","back":"Wise, with good judgement"},{"uid":"gre-words/0030","front":"tenacious","back":"Holding firmly on; persistent"},{"uid":"gre-words/0031","front":"vacillate","back":"To keep changing one's mind"},{"uid":"gre-words/0032","front":"wary","back":"Cautious about possible dangers"},{"uid":"gre-words/0033","front":"zealous","back":"Full of energy and enthusiasm for a cause"},{"uid":"gre-words/0034","front":"abate","back":"To become less intense"},{"uid":"gre-words/0035","front":"aberrant","back":"Departing from the usual or the accepted way"},{"uid":"gre-words/0036","front":"acrimony","back":"Bitter, angry feeling in speech or manner"},{"uid":"gre-words/0037","front":"alacrity","back":"Cheerful readiness and speed"},{"uid":"gre-words/0038","front":"ambivalent","back":"Having mixed or conflicting feelings"},{"uid":"gre-words/0039","front":"apathy","back":"Lack of interest or concern"},{"uid":"gre-words/0040","front":"arduous","back":"Needing a lot of effort; tiring"},{"uid":"gre-words/0041","front":"austere","back":"Plain and strict, without comfort or decoration"},{"uid":"gre-words/0042","front":"belligerent","back":"Hostile and eager to fight"},{"uid":"gre-words/0043","front":"bolster","back":"To support or strengthen"},{"uid":"gre-words/0044","front":"capricious","back":"Changing mood or behaviour suddenly and without reason"},{"uid":"gre-words/0045","front":"circumspect","back":"Careful to consider risks before acting"},{"uid":"gre-words/0046","front":"clandestine","back":"Kept secret, often because it is not allowed"},{"uid":"gre-words/0047","front":"conundrum","back":"A confusing problem or puzzle"},{"uid":"gre-words/0048","front":"copious","back":"Plentiful; in large amounts"},{"uid":"gre-words/0049","front":"deleterious","back":"Harmful"},{"uid":"gre-words/0050","front":"didactic","back":"Meant to teach, often in a preachy way"},{"uid":"gre-words/0051","front":"discern","back":"To notice or recognise something not obvious"},{"uid":"gre-words/0052","front":"ebullient","back":"Cheerful and full of energy"},{"uid":"gre-words/0053","front":"enigmatic","back":"Mysterious and hard to understand"},{"uid":"gre-words/0054","front":"esoteric","back":"Understood by only a small group with special knowledge"},{"uid":"gre-words/0055","front":"exacerbate","back":"To make a problem worse"},{"uid":"gre-words/0056","front":"frugal","back":"Careful with money or resources"},{"uid":"gre-words/0057","front":"garrulous","back":"Talkative, especially about unimportant things"},{"uid":"gre-words/0058","front":"harangue","back":"A long, forceful, critical speech"},{"uid":"gre-words/0059","front":"impetuous","back":"Acting quickly without thinking"}]}
