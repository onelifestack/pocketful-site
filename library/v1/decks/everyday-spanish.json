{"id":"everyday-spanish","version":1,"updatedAt":"2026-11-12","name":"Everyday Spanish phrases","category":"Languages","blurb":"gentle start","colors":["#FFC94D","#FF8E72"],"cards":[{"uid":"everyday-spanish/0001","front":"Hola","back":"Hello"},{"uid":"everyday-spanish/0002","front":"Buenos días","back":"Good morning"},{"uid":"everyday-spanish/0003","front":"Buenas tardes","back":"Good afternoon"},{"uid":"everyday-spanish/0004","front":"Buenas noches","back":"Good evening / good night"},{"uid":"everyday-spanish/0005","front":"Adiós","back":"Goodbye"},{"uid":"everyday-spanish/0006","front":"Hasta luego","back":"See you later"},{"uid":"everyday-spanish/0007","front":"Hasta mañana","back":"See you tomorrow"},{"uid":"everyday-spanish/0008","front":"Por favor","back":"Please"},{"uid":"everyday-spanish/0009","front":"Gracias","back":"Thank you"},{"uid":"everyday-spanish/0010","front":"Muchas gracias","back":"Thank you very much"},{"uid":"everyday-spanish/0011","front":"De nada","back":"You're welcome"},{"uid":"everyday-spanish/0012","front":"Perdón","back":"Sorry / excuse me"},{"uid":"everyday-spanish/0013","front":"Lo siento","back":"I'm sorry"},{"uid":"everyday-spanish/0014","front":"Con permiso","back":"Excuse me (to pass by)"},{"uid":"everyday-spanish/0015","front":"¿Cómo estás?","back":"How are you?"},{"uid":"everyday-spanish/0016","front":"Estoy bien, gracias","back":"I'm fine, thanks"},{"uid":"everyday-spanish/0017","front":"¿Cómo te llamas?","back":"What's your name?"},{"uid":"everyday-spanish/0018","front":"Me llamo…","back":"My name is…"},{"uid":"everyday-spanish/0019","front":"Mucho gusto","back":"Nice to meet you"},{"uid":"everyday-spanish/0020","front":"¿De dónde eres?","back":"Where are you from?"},{"uid":"everyday-spanish/0021","front":"Soy de…","back":"I'm from…"},{"uid":"everyday-spanish/0022","front":"¿Hablas inglés?","back":"Do you speak English?"},{"uid":"everyday-spanish/0023","front":"No entiendo","back":"I don't understand"},{"uid":"everyday-spanish/